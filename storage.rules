rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "Ry06huUzzmeqryzna9lPzpNw4Rr1"
        && request.auth.token.email == "ridoyhasank5434@gmail.com"
        && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.role == "admin"
        && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    match /property-images/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isAdmin();
    }
  }
}
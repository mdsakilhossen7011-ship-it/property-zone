rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // An admin must have an active admin document. Never trust a client-side role alone.
    function isAdmin() {
      return signedIn()
        && request.auth.uid == "Ry06huUzzmeqryzna9lPzpNw4Rr1"
        && request.auth.token.email == "ridoyhasank5434@gmail.com"
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == "admin"
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    match /admins/{adminId} {
      allow get: if signedIn() && request.auth.uid == adminId;
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /members/{memberId} {
      allow create: if signedIn()
        && request.auth.uid == memberId
        && request.resource.data.uid == memberId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == "active"
        && request.resource.data.name is string
        && request.resource.data.referralCode is string
        && request.resource.data.referredByCode is string;
      allow get: if (signedIn() && request.auth.uid == memberId) || isAdmin();
      allow list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['firstName','lastName','email','phoneNumber','phoneVerified','referralCode','createdAt','role','emailVerified'])
        && request.resource.data.keys().hasOnly(['firstName','lastName','email','phoneNumber','phoneVerified','referralCode','createdAt','role','emailVerified'])
        && request.resource.data.role == 'member'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.phoneVerified == false
        && request.resource.data.emailVerified == false
        && (request.resource.data.phoneNumber == null || request.resource.data.phoneNumber is string)
        && (request.resource.data.referralCode == null || request.resource.data.referralCode is string);
      allow get: if signedIn() && request.auth.uid == userId;
      allow list: if false;
      allow update, delete: if false;
    }

    function validPackageAmount(amount) {
      return amount in [1000, 2000, 5000, 10000, 20000, 50000, 100000];
    }

    match /wallets/{memberId} {
      allow get: if (signedIn() && request.auth.uid == memberId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.uid == memberId
        && ((request.resource.data.balanceBDT is number && request.resource.data.balanceBDT >= 0)
          || (request.resource.data.balanceUSD is number && request.resource.data.balanceUSD >= 0));
      allow update: if isAdmin() || (signedIn()
        && request.auth.uid == memberId
        && resource.data.uid == memberId
        && request.resource.data.uid == memberId
        && resource.data.balanceBDT is number
        && request.resource.data.balanceBDT is number
        && request.resource.data.balanceBDT >= 0
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balanceBDT','updatedAt'])
        && validPackageAmount(resource.data.balanceBDT - request.resource.data.balanceBDT));
      allow delete: if isAdmin();
    }

    match /activePackages/{packageId} {
      allow get, list: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','propertyId','propertyTitle','amountBDT','dailyRate','hourlyRate','termDays','maturityAt','status','startedAt','createdAt'])
        && validPackageAmount(request.resource.data.amountBDT)
        && request.resource.data.dailyRate == 0.02
        && request.resource.data.hourlyRate == 0.02 / 24
        && request.resource.data.termDays == 30
        && request.resource.data.maturityAt is timestamp
        && request.resource.data.status == 'active'
        && request.resource.data.startedAt is timestamp
        && request.resource.data.createdAt is timestamp
        && exists(/databases/$(database)/documents/wallets/$(request.auth.uid))
        && get(/databases/$(database)/documents/wallets/$(request.auth.uid)).data.balanceBDT is number
        && getAfter(/databases/$(database)/documents/wallets/$(request.auth.uid)).data.balanceBDT
          == get(/databases/$(database)/documents/wallets/$(request.auth.uid)).data.balanceBDT - request.resource.data.amountBDT;
      allow update, delete: if isAdmin();
    }

    match /properties/{propertyId} {
      allow get, list: if isAdmin() || resource.data.status == "published";
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(["title","location","type","availability","price","description","status","createdAt","updatedAt","createdBy"])
        && request.resource.data.status in ["draft","published"];
      allow update, delete: if isAdmin();
    }

    match /propertySubmissions/{submissionId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.title is string
        && request.resource.data.location is string
        && request.resource.data.type is string
        && request.resource.data.price is string
        && request.resource.data.description is string;
      allow get, list: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /propertyEnquiries/{enquiryId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.status in ["open", "pending"]
        && (
          request.resource.data.propertyId is string
          || (
            request.resource.data.requestType in ["wallet-deposit", "wallet-withdraw"]
            && request.resource.data.keys().hasOnly([
              "requestType", "uid", "email", "name", "amountUSD", "amountBDT", "exchangeRateBDT", "paymentCurrency",
              "paymentMethod", "walletNumber", "paymentAccount", "senderAccount",
              "receivingAccount", "adminPayoutAccount", "transactionId", "message",
              "status", "createdAt"
            ])
            && request.resource.data.amountUSD is number
            && request.resource.data.amountUSD > 0
             && request.resource.data.amountBDT is int
             && request.resource.data.amountBDT > 0
             && request.resource.data.exchangeRateBDT is number
             && request.resource.data.exchangeRateBDT > 0
             && exists(/databases/$(database)/documents/siteSettings/wallet)
             && request.resource.data.exchangeRateBDT == get(/databases/$(database)/documents/siteSettings/wallet).data.exchangeRateBDT
             && request.resource.data.amountUSD == math.round((request.resource.data.amountBDT / request.resource.data.exchangeRateBDT) * 100) / 100
             && request.resource.data.status == "pending"
             && (request.resource.data.requestType != "wallet-withdraw" || get(/databases/$(database)/documents/siteSettings/wallet).data.minimumWithdrawBDT is int && get(/databases/$(database)/documents/siteSettings/wallet).data.minimumWithdrawBDT >= 500 && request.resource.data.amountBDT >= get(/databases/$(database)/documents/siteSettings/wallet).data.minimumWithdrawBDT)
            && request.resource.data.paymentCurrency == "BDT"
            && request.resource.data.paymentMethod in ["bKash", "Nagad", "Binance"]
            && request.resource.data.walletNumber is string
            && request.resource.data.walletNumber.size() >= 3
            && request.resource.data.walletNumber.size() <= 100
            && request.resource.data.createdAt is timestamp
            && (
              (request.resource.data.requestType == "wallet-deposit"
                && request.resource.data.senderAccount is string
                && request.resource.data.receivingAccount is string
                && request.resource.data.receivingAccount.size() > 0
                && request.resource.data.transactionId is string
                && request.resource.data.transactionId.size() > 0)
              || (request.resource.data.requestType == "wallet-withdraw"
                && request.resource.data.adminPayoutAccount is string
                && request.resource.data.adminPayoutAccount.size() > 0)
            )
          )
        );
       allow get, list: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /supportChats/{chatId} {
      allow create: if signedIn() && request.auth.uid == chatId
        && request.resource.data.uid == chatId
        && request.resource.data.status == "open";
      allow get: if signedIn() && (request.auth.uid == chatId || isAdmin());
      allow list: if isAdmin();
      allow update: if isAdmin() || (signedIn() && request.auth.uid == chatId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage','updatedAt','status']));
      allow delete: if isAdmin();
      match /messages/{messageId} {
        allow create: if signedIn()
          && ((request.auth.uid == chatId && request.resource.data.senderRole == 'user')
            || (isAdmin() && request.resource.data.senderRole == 'admin'))
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          && (request.resource.data.text.size() > 0
            || (request.resource.data.imageData is string && request.resource.data.imageData.size() > 0))
          && request.resource.data.createdAt is timestamp
          && exists(/databases/$(database)/documents/supportChats/$(chatId));
        allow get, list: if signedIn() && (request.auth.uid == chatId || isAdmin());
        allow update, delete: if false;
      }
    }

    match /supportMessages/{messageId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.subject is string
        && request.resource.data.message is string
        && request.resource.data.status == "open";
      allow get, list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /offers/{offerId} {
      allow get, list: if isAdmin() || resource.data.status == "published";
      allow create, update, delete: if isAdmin();
    }
    match /notices/{noticeId} {
      allow get, list: if isAdmin() || (signedIn() && resource.data.status == "published");
      allow create, update, delete: if isAdmin();
    }
    match /siteSettings/{settingId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }
    match /referralSettings/{settingId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }
    match /referralRegistrations/{code}/members/{memberId} {
      allow get, list: if isAdmin() || (signedIn()
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.referralCode == code);
      allow create: if isAdmin() || (signedIn()
        && request.auth.uid == memberId
        && exists(/databases/$(database)/documents/members/$(memberId))
        && get(/databases/$(database)/documents/members/$(memberId)).data.referredByCode == code
        && request.resource.data.keys().hasAll(['createdAt'])
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt is timestamp);
      allow update, delete: if false;
    }
    match /referralCodes/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if isAdmin() || (signedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.referralCode == code
        && request.resource.data.keys().hasAll(['code','active','createdAt'])
        && request.resource.data.keys().hasOnly(['code','active','createdAt'])
        && request.resource.data.code == code
        && request.resource.data.active == true
        && request.resource.data.createdAt is timestamp);
      allow update, delete: if isAdmin();
    }
    match /activityLogs/{logId} {
      allow get, list, create, update, delete: if isAdmin();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
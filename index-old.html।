<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#090909">
<title>Property Zone | Luxury Property Portfolio</title>
<style>
:root{--bg:#090909;--panel:#121212;--panel2:#191714;--gold:#d6ad52;--gold2:#f2d58a;--muted:#a9a39a;--line:#3a3020;--white:#f6f2e9}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--white);font-family:Inter,system-ui,Arial,sans-serif}button,input{font:inherit}button{cursor:pointer}.top{position:sticky;top:0;z-index:5;background:#090909ee;border-bottom:1px solid var(--line);backdrop-filter:blur(12px)}.nav{max-width:1100px;margin:auto;padding:14px 18px;display:flex;align-items:center;justify-content:space-between;gap:12px}.brand{display:flex;align-items:center;gap:10px;font-weight:800;color:var(--gold2);font-size:20px}.logo{width:42px;height:42px;border-radius:12px;background:linear-gradient(135deg,#f0d17d,#9a6c1f);display:grid;place-items:center;color:#16110a;font-size:23px}.navlinks{display:flex;gap:8px;flex-wrap:wrap}.btn{border:1px solid var(--line);background:#17140f;color:var(--gold2);padding:10px 15px;border-radius:10px;font-weight:650}.btn.primary{background:linear-gradient(135deg,#e8c66e,#a87928);color:#171109;border:0}.btn.ghost{background:transparent}.wrap{max-width:1100px;margin:auto;padding:28px 18px 70px}.hero{padding:42px 0 28px;display:grid;grid-template-columns:1.15fr .85fr;gap:24px;align-items:center}.eyebrow{color:var(--gold);letter-spacing:3px;text-transform:uppercase;font-size:11px;font-weight:800}.hero h1{font-family:Georgia,serif;font-size:clamp(38px,7vw,66px);line-height:1.02;margin:12px 0}.hero h1 span{color:var(--gold2)}.muted{color:var(--muted);line-height:1.65}.heroart{min-height:260px;border:1px solid var(--line);border-radius:20px;background:radial-gradient(circle at 60% 35%,#5a431f 0,#20190f 38%,#100f0d 75%);display:flex;align-items:end;padding:22px;overflow:hidden;position:relative}.heroart:before{content:"";position:absolute;width:190px;height:220px;right:18%;bottom:0;border:8px solid #b88a3d;border-bottom:0;opacity:.45;transform:skewY(-8deg)}.heroart:after{content:"";position:absolute;width:130px;height:170px;right:10%;bottom:0;border:6px solid #e0bd68;border-bottom:0;opacity:.3}.heroart strong{position:relative;z-index:1;font:28px Georgia;color:#f0d58f}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:12px 0 34px}.stat,.card,.panel{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:17px}.stat b{display:block;color:var(--gold2);font:26px Georgia}.stat small{color:var(--muted)}.sectionhead{display:flex;align-items:end;justify-content:space-between;gap:14px;margin:28px 0 16px}.sectionhead h2{font:30px Georgia;margin:0}.filters{display:flex;gap:8px;flex-wrap:wrap}.search{width:100%;padding:13px 15px;background:#111;border:1px solid var(--line);border-radius:11px;color:white;margin:12px 0 16px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.property{overflow:hidden;padding:0}.photo{height:160px;background:linear-gradient(135deg,#3b3021,#151515);display:flex;align-items:end;padding:14px;position:relative}.photo:after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,#0009,transparent)}.photo span{position:relative;z-index:1;background:#d6ad52;color:#171109;border-radius:20px;padding:5px 9px;font-size:11px;font-weight:800}.propbody{padding:16px}.propbody h3{margin:0 0 6px;font:22px Georgia}.location{font-size:13px;color:var(--muted)}.meta{display:flex;justify-content:space-between;margin:14px 0;color:var(--muted);font-size:13px}.price{color:var(--gold2);font-weight:800}.cardactions{display:flex;gap:8px}.cardactions button{flex:1}.hidden{display:none!important}.view{display:none}.view.active{display:block}.form{max-width:460px;margin:24px auto}.form input{display:block;width:100%;padding:13px;margin:10px 0;background:#0c0c0c;border:1px solid var(--line);border-radius:9px;color:white}.notice{font-size:12px;color:#b9ad96;line-height:1.5}.packages{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:16px}.package{border:1px solid var(--line);background:#15130f;border-radius:13px;padding:15px}.package b{color:var(--gold2);font-size:20px}.table{width:100%;border-collapse:collapse;font-size:13px}.table td,.table th{padding:11px;border-bottom:1px solid var(--line);text-align:left}.table th{color:var(--gold2)}footer{border-top:1px solid var(--line);padding:24px;text-align:center;color:var(--muted);font-size:12px;margin-top:50px}
@media(max-width:760px){.hero{grid-template-columns:1fr;padding-top:25px}.heroart{min-height:180px}.grid{grid-template-columns:1fr}.stats{grid-template-columns:1fr 1fr}.nav{align-items:flex-start}.navlinks{justify-content:flex-end}.navlinks .btn{padding:8px 10px;font-size:12px}.packages{grid-template-columns:1fr}.sectionhead{align-items:flex-start;flex-direction:column}}
</style>
</head>
<body>
<header class="top"><div class="nav"><div class="brand"><div class="logo">⌂</div> PROPERTY ZONE</div><div class="navlinks"><button class="btn ghost" onclick="showView('home')">Home</button><button class="btn ghost" onclick="showView('dashboard')">Dashboard</button><button class="btn" onclick="showView('login')">Login</button><button class="btn primary" onclick="showView('register')">Join Now</button></div></div></header>
<main class="wrap">
<section id="home" class="view active">
<div class="hero"><div><div class="eyebrow">Curated property portfolio</div><h1>Discover <span>Exceptional</span> Properties</h1><p class="muted">Explore a curated collection of property opportunities. Review each listing, its details and available participation packages.</p><button class="btn primary" onclick="document.getElementById('listings').scrollIntoView({behavior:'smooth'})">Explore Properties →</button></div><div class="heroart"><strong>Own the view.<br>Explore the future.</strong></div></div>
<div class="stats"><div class="stat"><b>06</b><small>Sample properties</small></div><div class="stat"><b>03</b><small>Package levels</small></div><div class="stat"><b>24/7</b><small>Portfolio access</small></div></div>
<div id="listings" class="sectionhead"><div><div class="eyebrow">Our portfolio</div><h2>Featured Properties</h2></div></div>
<input class="search" id="search" placeholder="Search by property or location..." oninput="renderProperties()">
<div class="filters"><button class="btn primary" onclick="setFilter('All',this)">All</button><button class="btn" onclick="setFilter('Available',this)">Available</button><button class="btn" onclick="setFilter('Upcoming',this)">Upcoming</button></div>
<div class="grid" id="propertyGrid"></div>
</section>
<section id="details" class="view"><button class="btn" onclick="showView('home')">← Back to properties</button><div id="detailContent"></div></section>
<section id="login" class="view"><div class="panel form"><div class="eyebrow">Welcome back</div><h2>Member Login</h2><input id="loginEmail" type="email" placeholder="Email address"><input id="loginPass" type="password" placeholder="Password"><button class="btn primary" style="width:100%" onclick="login()">Login to demo</button><p class="notice">Demo only: this does not create a secure account or verify identity. Real authentication will be connected later.</p><p>New here? <a href="#" onclick="showView('register')" style="color:var(--gold2)">Create account</a></p></div></section>
<section id="register" class="view"><div class="panel form"><div class="eyebrow">Become a member</div><h2>Create Demo Account</h2><input id="regName" placeholder="Full name"><input id="regEmail" type="email" placeholder="Email address"><input id="regPass" type="password" placeholder="Create password"><button class="btn primary" style="width:100%" onclick="register()">Create demo account</button><p class="notice">Demo only. Do not enter your real NID, OTP, bank, or payment details. Identity verification is not active yet.</p></div></section>
<section id="dashboard" class="view"><div class="sectionhead"><div><div class="eyebrow">Member area</div><h2>My Dashboard</h2></div><button class="btn" onclick="logout()">Log out</button></div><div class="stats"><div class="stat"><b id="dashName">Guest</b><small>Account</small></div><div class="stat"><b>৳0</b><small>Demo balance</small></div><div class="stat"><b>0</b><small>Participations</small></div></div><div class="panel"><h3>Account status</h3><p class="muted">Demo account only — real login, KYC verification, wallet and profit distribution are not connected.</p></div></section>
<section id="admin" class="view"><div class="sectionhead"><div><div class="eyebrow">Management</div><h2>Admin Demo</h2></div></div><div class="panel"><p class="muted">This is a visual demo only. No secure admin authentication or database is connected.</p><table class="table"><tr><th>Property</th><th>Status</th><th>Packages</th></tr><tr><td>Golden Heights</td><td>Available</td><td>3</td></tr><tr><td>Royal Residence</td><td>Upcoming</td><td>3</td></tr></table></div></section>
</main><footer>© 2026 Property Zone · Demo website · No real investment or payment services are active.</footer>
<script>
const properties=[
{id:1,name:"Golden Heights",loc:"Gulshan, Dhaka",status:"Available",type:"Luxury Apartments",desc:"A sample premium residential development concept in a prime urban location.",packages:[1000,2000,5000]},
{id:2,name:"Royal Residence",loc:"Banani, Dhaka",status:"Available",type:"Residential",desc:"A sample modern residence portfolio listing with landscaped surroundings.",packages:[1000,3000,5000]},
{id:3,name:"Emerald Business Tower",loc:"Motijheel, Dhaka",status:"Upcoming",type:"Commercial",desc:"A sample commercial tower listing for the demo portfolio.",packages:[2000,3000,5000]},
{id:4,name:"Lakeside Villas",loc:"Purbachal, Dhaka",status:"Available",type:"Villas",desc:"A sample lakeside villa development concept.",packages:[1000,2000,4000]},
{id:5,name:"Heritage Plaza",loc:"Dhanmondi, Dhaka",status:"Upcoming",type:"Mixed Use",desc:"A sample mixed-use property listing.",packages:[1000,3000,5000]},
{id:6,name:"Skyline Suites",loc:"Uttara, Dhaka",status:"Available",type:"Serviced Apartments",desc:"A sample serviced apartment property listing.",packages:[2000,4000,5000]}
];let filter="All",currentUser=null;
function renderProperties(){let q=(document.getElementById('search')?.value||'').toLowerCase();let list=properties.filter(p=>(filter==='All'||p.status===filter)&&(p.name+' '+p.loc+' '+p.type).toLowerCase().includes(q));document.getElementById('propertyGrid').innerHTML=list.length?list.map(p=>`<article class="card property"><div class="photo"><span>${p.status}</span></div><div class="propbody"><h3>${p.name}</h3><div class="location">⌖ ${p.loc} · ${p.type}</div><p class="muted">${p.desc}</p><div class="meta"><span>Packages</span><span class="price">${p.packages.length} options</span></div><div class="cardactions"><button class="btn primary" onclick="openProperty(${p.id})">View details</button></div></div></article>`).join(''):'<p class="muted">No properties match your search.</p>'}
function setFilter(f,b){filter=f;document.querySelectorAll('.filters .btn').forEach(x=>x.classList.remove('primary'));b.classList.add('primary');renderProperties()}
function showView(id){document.querySelectorAll('.view').forEach(v=>v.classList.remove('active'));document.getElementById(id).classList.add('active');window.scrollTo(0,0);if(id==='dashboard')document.getElementById('dashName').textContent=currentUser?.name||'Guest'}
function openProperty(id){let p=properties.find(x=>x.id===id);document.getElementById('detailContent').innerHTML=`<div class="hero"><div><div class="eyebrow">${p.status} · ${p.type}</div><h1>${p.name}</h1><p class="muted">⌖ ${p.loc}</p><p class="muted">${p.desc}</p></div><div class="heroart"><strong>${p.name}</strong></div></div><h2>Demo packages</h2><p class="notice">These are sample package amounts only, not offers to invest and not promises of returns.</p><div class="packages">${p.packages.map(n=>`<div class="package"><div class="eyebrow">Participation tier</div><h3>Package</h3><b>৳${n.toLocaleString('en-BD')}</b><p class="notice">Demo amount · no payment enabled</p><button class="btn" onclick="showView('register')">Register to explore</button></div>`).join('')}</div>`;showView('details')}
function register(){let name=document.getElementById('regName').value.trim(),email=document.getElementById('regEmail').value.trim(),pass=document.getElementById('regPass').value;if(!name||!email||!pass){alert('Please fill all fields');return}currentUser={name,email};alert('Demo account created in this browser only. Not a real secure account.');showView('dashboard')}
function login(){let email=document.getElementById('loginEmail').value.trim();if(!email){alert('Enter an email address');return}currentUser={name:email.split('@')[0],email};alert('Demo login only.');showView('dashboard')}
function logout(){currentUser=null;showView('home')}
renderProperties();
</script>
